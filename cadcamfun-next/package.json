{
  "name": "cadcamfun-next",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.14",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "bun run --filter '@cadcamfun/server' --filter '@cadcamfun/web' dev",
    "build": "bun run --cwd apps/web build",
    "start": "CADCAMFUN_STATIC_DIR=apps/web/dist bun packages/server/src/main.ts",
    "typecheck": "bun run --filter '*' typecheck",
    "test": "bun run --filter '*' test",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@effect/language-service": "0.87.3",
    "@types/bun": "1.3.14",
    "typescript": "5.9.3",
    "prettier": "3.8.4"
  }
}
