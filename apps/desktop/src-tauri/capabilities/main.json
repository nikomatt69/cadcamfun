{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "Permissions for the main window. Nothing here is granted to remote content.",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "core:window:allow-destroy",
    "log:default",
    "notification:allow-is-permission-granted",
    "notification:allow-request-permission",
    "notification:allow-notify",
    "shell:allow-open",
    "clipboard-manager:allow-write-text",
    "allow-get-sidecar-endpoint",
    "allow-prepare-viewport-edges",
    "allow-get-logs-dir",
    "allow-open-path",
    "allow-secret-get",
    "allow-secret-set",
    "allow-secret-delete",
    "allow-pick-file",
    "allow-save-file",
    "allow-take-opened-files",
    "allow-read-opened-file",
    "allow-set-recent-projects",
    "allow-set-menu-accelerators",
    "allow-check-for-updates",
    "allow-get-update-status",
    "allow-install-update",
    "allow-apply-update",
    "allow-restart-app",
    "allow-open-release-notes",
    "allow-begin-job-activity",
    "allow-end-job-activity",
    "core:window:allow-set-progress-bar"
  ]
}
