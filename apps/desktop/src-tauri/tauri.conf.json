{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CADCAM FUN",
  "version": "0.1.11",
  "identifier": "com.cadcamfun.app",
  "build": {
    "beforeDevCommand": "bun run dev",
    "beforeBuildCommand": "bun run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "CADCAM FUN",
        "width": 1440,
        "height": 900,
        "minWidth": 960,
        "minHeight": 600,
        "resizable": true,
        "center": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": {
          "x": 14,
          "y": 18
        },
        "transparent": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' http://127.0.0.1:* ipc: http://ipc.localhost; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; script-src 'self' 'wasm-unsafe-eval' 'unsafe-eval'; worker-src 'self' blob:",
      "devCsp": "default-src 'self' http://localhost:1420; connect-src 'self' http://127.0.0.1:* ws://localhost:* http://localhost:* ipc: http://ipc.localhost; img-src 'self' data: blob: http://localhost:1420; style-src 'self' 'unsafe-inline' http://localhost:1420; script-src 'self' 'unsafe-inline' 'unsafe-eval' http://localhost:1420; worker-src 'self' blob:",
      "freezePrototype": false,
      "capabilities": [
        "main",
        "glass"
      ]
    },
    "macOSPrivateApi": true
  },
  "bundle": {
    "active": true,
    "targets": [
      "deb",
      "rpm",
      "app",
      "dmg",
      "nsis",
      "msi"
    ],
    "category": "DeveloperTool",
    "macOS": {
      "infoPlist": "Info.plist"
    },
    "shortDescription": "CAD/CAM desktop application",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": [
      "binaries/sidecar"
    ],
    "resources": {
      "resources/migrations/": "migrations/",
      "THIRD_PARTY_NOTICES.md": "THIRD_PARTY_NOTICES.md"
    },
    "fileAssociations": [
      {
        "ext": [
          "cadcam"
        ],
        "name": "CADCAM FUN project",
        "description": "CADCAM FUN project export",
        "role": "Editor"
      },
      {
        "ext": [
          "nc",
          "gcode"
        ],
        "name": "G-code program",
        "description": "G-code / NC program",
        "role": "Viewer"
      }
    ]
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/nikomatt69/cadcamfun/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEVGRTYzNjM1QkVCNjBEMTkKUldRWkRiYStOVGJtN3diaHZBNnh4SGtneGRHU3Frc3BwWnJjbk9od2xvQ3NKd0lGNWZCZUtqaEgK",
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
