{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    "types": [
      "bun"
    ],
    "lib": [
      "ES2023",
      "DOM",
      "DOM.Iterable"
    ],
    "paths": {
      "@/*": [
        "./*"
      ],
      "@cadcamfun/api": [
        "../../packages/api/src/index.ts"
      ]
    }
  },
  "include": [
    "app",
    "components",
    "lib",
    "modules",
    "test",
    "nativewind-env.d.ts",
    "css.d.ts",
    "metro.config.js",
    "babel.config.js",
    "tailwind.config.js"
  ],
  "exclude": [
    "node_modules",
    "dist",
    ".expo"
  ]
}
