{
  "name": "@cadcamfun/mobile",
  "version": "0.1.3",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start --dev-client",
    "ios": "expo run:ios",
    "dev": "expo start --dev-client",
    "ios:build": "expo run:ios --no-bundler",
    "ios:release": "expo run:ios --configuration Release --no-bundler",
    "ios:dev": "expo start --dev-client --ios --localhost",
    "web": "expo start --web",
    "native:generate": "expo prebuild --platform ios --no-install",
    "typecheck": "bun check -p tsconfig.json",
    "build": "expo export --platform ios --output-dir dist",
    "test": "bun test test"
  },
