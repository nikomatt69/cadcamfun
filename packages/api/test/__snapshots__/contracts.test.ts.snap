                                            "NaN",
                                          ],
                                          "type": "string",
                                        },
                                      ],
                                    },
                                  },
                                  "required": [
                                    "x",
                                    "y",
                                    "z",
                                  ],
                                  "type": "object",
                                },
                                "min": {
                                  "additionalProperties": false,
                                  "properties": {
                                    "x": {
                                      "anyOf": [
                                        {
                                          "type": "number",
                                        },
                                        {
                                          "enum": [
                                            "Infinity",
                                            "-Infinity",
                                            "NaN",
                                          ],
                                          "type": "string",
                                        },
                                      ],
                                    },
                                    "y": {
                                      "anyOf": [
                                        {
                                          "type": "number",
                                        },
                                        {
                                          "enum": [
                                            "Infinity",
                                            "-Infinity",
                                            "NaN",
                                          ],
                                          "type": "string",
                                        },
                                      ],
                                    },
                                    "z": {
                                      "anyOf": [
                                        {
                                          "type": "number",
                                        },
                                        {
                                          "enum": [
                                            "Infinity",
                                            "-Infinity",
                                            "NaN",
                                          ],
                                          "type": "string",
                                        },
                                      ],
                                    },
                                  },
                                  "required": [
