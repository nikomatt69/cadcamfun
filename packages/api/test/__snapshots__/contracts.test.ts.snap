    "/api/machine-configs/{id}/probe": {
      "get": {
        "operationId": "camProbing.probeConfigGet",
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "type": "string",
            },
          },
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": false,
                  "properties": {
                    "isOwner": {
                      "type": "boolean",
                    },
                    "machineConfigId": {
                      "type": "string",
                    },
                    "probing": {
                      "anyOf": [
                        {
                          "additionalProperties": false,
                          "properties": {
                            "backoff": {
                              "exclusiveMinimum": 0,
                              "type": "number",
                            },
                            "body": {
                              "additionalProperties": false,
                              "properties": {
                                "diameter": {
                                  "exclusiveMinimum": 0,
                                  "type": "number",
                                },
                                "length": {
                                  "exclusiveMinimum": 0,
                                  "type": "number",
                                },
                              },
                              "required": [
                                "diameter",
                                "length",
                              ],
                              "type": "object",
                            },
                            "calibration": {
                              "additionalProperties": false,
                              "properties": {
                                "calibratedAt": {
                                  "maxLength": 40,
                                  "type": "string",
                                },
                                "centreOffset": {
                                  "additionalProperties": false,
                                  "properties": {
                                    "x": {
                                      "type": "number",
                                    },
                                    "y": {
                                      "type": "number",
                                    },
                                  },
                                  "required": [
                                    "x",
                                    "y",
                                  ],
                                  "type": "object",
                                },
                                "directional": {
                                  "items": {
                                    "additionalProperties": false,
                                    "properties": {
                                      "angle": {
                                        "type": "number",
                                      },
                                      "radius": {
                                        "exclusiveMinimum": 0,
                                        "type": "number",
                                      },
                                    },
                                    "required": [
                                      "angle",
                                      "radius",
                                    ],
                                    "type": "object",
                                  },
                                  "maxItems": 64,
                                  "type": "array",
                                },
                                "effectiveRadius": {
                                  "exclusiveMinimum": 0,
                                  "type": "number",
                                },
                                "zTrigger": {
                                  "type": "number",
                                },
                              },
                              "required": [
                                "effectiveRadius",
                              ],
                              "type": "object",
                            },
                            "calibrationSource": {
                              "enum": [
                                "baked",
                                "variables",
                              ],
                              "type": "string",
                            },
                            "cycles": {
                              "items": {
                                "type": "string",
                              },
                              "type": "array",
                            },
                            "dialect": {
                              "enum": [
                                "linuxcnc",
                                "fanuc",
                              ],
                              "type": "string",
                            },
                            "doubleTouch": {
                              "type": "boolean",
                            },
                            "feed": {
                              "exclusiveMinimum": 0,
                              "type": "number",
                            },
                            "feeds": {
                              "additionalProperties": false,
                              "properties": {
                                "fast": {
                                  "exclusiveMinimum": 0,
                                  "type": "number",
                                },
                                "max": {
                                  "exclusiveMinimum": 0,
                                  "type": "number",
                                },
                                "positioning": {
                                  "exclusiveMinimum": 0,
                                  "type": "number",
                                },
                                "touch": {
                                  "exclusiveMinimum": 0,
                                  "type": "number",
                                },
                              },
                              "type": "object",
                            },
                            "id": {
                              "maxLength": 64,
                              "minLength": 1,
                              "type": "string",
                            },
                            "macroStyle": {
                              "enum": [
                                "inline",
                                "renishaw",
                                "heidenhain-ts",
                                "siemens-cycles",
                              ],
                              "type": "string",
                            },
                            "off": {
                              "items": {
                                "maxLength": 120,
                                "minLength": 1,
                                "pattern": "^[^\\r\\n]*$",
                                "type": "string",
                              },
                              "maxItems": 8,
                              "type": "array",
                            },
                            "offsets": {
                              "additionalProperties": false,
                              "properties": {
                                "extended": {
                                  "maximum": 300,
                                  "minimum": 0,
                                  "type": "integer",
                                },
                                "frames": {
                                  "maximum": 99,
                                  "minimum": 4,
                                  "type": "integer",
                                },
                                "presets": {
                                  "maximum": 99999,
                                  "minimum": 0,
                                  "type": "integer",
                                },
                              },
                              "type": "object",
                            },
                            "on": {
                              "items": {
                                "maxLength": 120,
                                "minLength": 1,
                                "pattern": "^[^\\r\\n]*$",
                                "type": "string",
                              },
                              "maxItems": 8,
                              "type": "array",
                            },
                            "orientSpindle": {
                              "maximum": 360,
                              "minimum": 0,
                              "type": "number",
                            },
                            "overtravel": {
                              "additionalProperties": false,
                              "properties": {
                                "xy": {
                                  "exclusiveMinimum": 0,
                                  "type": "number",
                                },
                                "z": {
                                  "exclusiveMinimum": 0,
                                  "type": "number",
                                },
                              },
                              "type": "object",
                            },
                            "shankDiameter": {
                              "exclusiveMinimum": 0,
                              "type": "number",
                            },
                            "skipCode": {
                              "pattern": "^G31(\\.\\d)?( P\\d)?$|^G38\\.[2-5]$",
                              "type": "string",
                            },
                            "skipFrame": {
                              "enum": [
                                "program",
                                "work",
                              ],
                              "type": "string",
                            },
                            "stylusDiameter": {
                              "exclusiveMinimum": 0,
                              "type": "number",
                            },
                            "stylusLength": {
                              "exclusiveMinimum": 0,
                              "type": "number",
                            },
                            "stylusRadius": {
                              "exclusiveMinimum": 0,
                              "type": "number",
                            },
                            "tiltedPlane": {
                              "type": "boolean",
                            },
                            "toolNumber": {
                              "maximum": 9999,
                              "minimum": 1,
                              "type": "integer",
                            },
                          },
                          "type": "object",
                        },
                        {
                          "type": "null",
                        },
                      ],
                    },
                    "rotaryCalibration": {
                      "anyOf": [
                        {
                          "additionalProperties": false,
                          "properties": {
                            "at": {
                              "maxLength": 40,
                              "minLength": 1,
                              "type": "string",
                            },
                            "axisDirection": {
                              "additionalProperties": false,
                              "properties": {
                                "x": {
                                  "type": "number",
                                },
                                "y": {
                                  "type": "number",
                                },
                                "z": {
                                  "type": "number",
                                },
                              },
                              "required": [
                                "x",
                                "y",
                                "z",
                              ],
                              "type": "object",
                            },
                            "axisError": {
                              "minimum": 0,
                              "type": "number",
                            },
                            "pivotMeasured": {
                              "additionalProperties": false,
                              "properties": {
                                "x": {
                                  "type": "number",
                                },
                                "y": {
                                  "type": "number",
                                },
                                "z": {
                                  "type": "number",
                                },
                              },
                              "required": [
                                "x",
                                "y",
                                "z",
                              ],
                              "type": "object",
                            },
                            "rms": {
                              "minimum": 0,
                              "type": "number",
                            },
                          },
                          "required": [
                            "at",
                          ],
                          "type": "object",
                        },
                        {
                          "type": "null",
                        },
                      ],
                    },
                    "toolSetter": {
                      "anyOf": [
                        {
                          "additionalProperties": false,
                          "properties": {
                            "brokenTolerance": {
                              "exclusiveMinimum": 0,
                              "type": "number",
                            },
                            "discDiameter": {
                              "exclusiveMinimum": 0,
                              "type": "number",
                            },
                            "feeds": {
                              "additionalProperties": false,
                              "properties": {
                                "fast": {
                                  "exclusiveMinimum": 0,
                                  "type": "number",
                                },
                                "touch": {
                                  "exclusiveMinimum": 0,
                                  "type": "number",
                                },
                              },
                              "required": [
                                "fast",
                                "touch",
                              ],
                              "type": "object",
                            },
                            "kind": {
                              "enum": [
                                "contact",
                                "laser",
                              ],
                              "type": "string",
                            },
                            "maxToolDiameter": {
                              "exclusiveMinimum": 0,
                              "type": "number",
                            },
                            "position": {
                              "additionalProperties": false,
                              "properties": {
                                "x": {
                                  "type": "number",
                                },
                                "y": {
                                  "type": "number",
                                },
                                "z": {
                                  "type": "number",
                                },
                              },
                              "required": [
                                "x",
                                "y",
                                "z",
                              ],
                              "type": "object",
                            },
                            "radiusRpm": {
                              "exclusiveMinimum": 0,
                              "type": "number",
                            },
                            "triggerZ": {
                              "type": "number",
                            },
                          },
                          "required": [
                            "kind",
                            "position",
                            "triggerZ",
                            "maxToolDiameter",
                            "feeds",
                            "brokenTolerance",
                          ],
                          "type": "object",
                        },
                        {
                          "type": "null",
                        },
                      ],
                    },
                    "updatedAt": {
                      "description": "ISO-8601 timestamp",
                      "type": "string",
                    },
                  },
                  "required": [
                    "machineConfigId",
                    "probing",
                    "toolSetter",
                    "rotaryCalibration",
                    "updatedAt",
                    "isOwner",
                  ],
                  "type": "object",
                },
              },
            },
            "description": "Success",
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BadRequestEncoded",
                },
              },
            },
            "description": "BadRequest",
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UnauthorizedEncoded",
                },
              },
            },
            "description": "Unauthorized",
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ForbiddenEncoded",
                },
              },
            },
            "description": "Forbidden",
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/NotFoundEncoded",
                },
              },
            },
            "description": "NotFound",
          },
          "500": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/InternalErrorEncoded",
                },
              },
            },
            "description": "InternalError",
          },
        },
