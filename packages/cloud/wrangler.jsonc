{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cadcamfun-cloud",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-29",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "observability": { "enabled": true },
  "containers": [{
    "class_name": "CloudWorkspace",
    "image": "../../Dockerfile",
    "image_build_context": "../..",
    "instance_type": "standard-1",
    "max_instances": 1
  }],
  "durable_objects": { "bindings": [{ "name": "WORKSPACE", "class_name": "CloudWorkspace" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["CloudWorkspace"] }],
  "r2_buckets": [{ "binding": "STATE", "bucket_name": "cadcamfun-cloud-state" }],
  "vars": {
    "IDENTITY_ISSUER": "https://auth.cadcam.fun",
    "WORKSPACE_ID": "personal",
    "PUBLIC_ORIGIN": "https://cloud.cadcam.fun"
  },
  "routes": [{ "pattern": "cloud.cadcam.fun", "custom_domain": true }]
}
