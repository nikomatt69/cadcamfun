---
import Layout from "../layouts/Layout.astro"
import Navbar from "../components/Navbar.astro"
import DownloadShot from "../components/stage/DownloadShot"
import FlowWindow from "../components/stage/FlowWindow"
import ReleaseBrowser from "../components/stage/ReleaseBrowser"
import TopicTile from "../components/stage/TopicTile"
import { text } from "../i18n/catalog"
import { ui } from "../i18n/ui"

export const prerender = false

const locale = Astro.locals.locale ?? "en"
const description = "Download CADCAMFUN for macOS, Windows, and Linux. Desktop installers from the GitHub releases, with checksums."

const brand = [
  { file: "icon.png", label: "App icon" },
  { file: "logo.png", label: "Logo" },
  { file: "logo-on-dark.png", label: "Logo on dark" },
  { file: "og-image.png", label: "Social image" },
]

const labels = {
  dmg: text(locale, "Disk image"),
  msi: text(locale, "MSI installer"),
  nsis: text(locale, "NSIS installer"),
  deb: text(locale, "Debian package"),
  rpm: text(locale, "RPM package"),
  checksums: text(locale, "SHA-256 checksums"),
  notes: text(locale, "Release notes"),
  notInRelease: text(locale, "Not in this release."),
  detected: text(locale, "Detected {os}. Matching builds are marked below."),
  empty: text(locale, "No stable desktop installers are published yet. Build from source with the quickstart."),
  failed: text(locale, "The release list could not be loaded. Open the GitHub releases page, or try again in a moment."),
  loading: text(locale, "Loading releases…"),
  version: text(locale, "Version"),
  allReleases: text(locale, "All releases"),
  copy: text(locale, "Copy"),
  copied: text(locale, "Copied"),
}
---

<Layout title="Download — CADCAMFUN" description={description}>
  <Navbar />
  <main id="main-content" class="page-section">
    <div class="page-shell">
      <p class="font-mono text-[11px] uppercase tracking-[0.16em] text-terminal-muted">{ui(locale, "download")}</p>
      <h1 class="font-display mt-3 max-w-3xl text-[clamp(2.2rem,5vw,3.6rem)] font-bold leading-[1.05] tracking-[-0.03em]">{text(locale, "Get CADCAMFUN for your platform.")}</h1>
      <p class="mt-4 max-w-2xl text-[16px] leading-relaxed text-terminal-muted">
        {text(locale, "Desktop installers for macOS, Windows, and Linux. Each file is the asset published on the matching GitHub release. The in-app updater covers macOS and Windows.")}
      </p>
      <div class="mt-10 max-w-[760px]" aria-hidden="true"><DownloadShot client:only="react" /></div>
      <ReleaseBrowser client:only="react" labels={labels} />
      <noscript><p class="mt-6 text-[14px]"><a class="font-semibold text-terminal-accent" href="https://github.com/nikomatt69/cadcamfun/releases">{labels.allReleases}</a></p></noscript>

      <section class="mt-14" aria-labelledby="homebrew-heading">
        <h2 id="homebrew-heading" class="font-display text-[1.6rem] font-bold tracking-[-0.03em]">{text(locale, "macOS with Homebrew")}</h2>
        <p class="mt-3 max-w-2xl text-[15px] leading-relaxed text-terminal-muted">
          {text(locale, "When the release cask is published, this installs the macOS app. It does not replace the Windows or Linux packages above.")}
        </p>
        <div class="mt-4 flex flex-wrap items-center gap-3">
          <div class="homebrew-command min-w-0 w-[520px] max-w-full"><FlowWindow client:load title="Terminal"><code>brew install --cask nikomatt69/tap/cadcamfun</code></FlowWindow></div>
          <button id="homebrew-copy" type="button" class="pressable glass-chip shrink-0 px-3 py-1.5 text-[13px] font-semibold" data-copy-label={labels.copy} data-copied-label={labels.copied}>{labels.copy}</button>
          <span id="homebrew-copy-status" class="sr-only" role="status"></span>
        </div>
      </section>

      <section class="mt-14" aria-labelledby="updater-heading">
        <h2 id="updater-heading" class="font-display text-[1.6rem] font-bold tracking-[-0.03em]">{text(locale, "Updates")}</h2>
        <p class="mt-3 max-w-2xl text-[15px] leading-relaxed text-terminal-muted">
          {text(locale, "Installed macOS and Windows copies check")} <code>latest.json</code> {text(locale, "on the latest GitHub release. Linux publishes")} <code>.deb</code> {text(locale, "and")} <code>.rpm</code> {text(locale, "only; there is no AppImage and no in-app Linux update. Checksums for a platform are the")} <code>SHA256SUMS</code> {text(locale, "file on that platform’s release.")}
        </p>
        <div class="mt-6 max-w-[400px]"><TopicTile kind="update" client:only="react" /></div>
      </section>

      <section class="mt-14" aria-labelledby="companion-heading">
        <h2 id="companion-heading" class="font-display text-[1.6rem] font-bold tracking-[-0.03em]">{text(locale, "iOS companion")}</h2>
        <p class="mt-3 max-w-2xl text-[15px] leading-relaxed text-terminal-muted">
          {text(locale, "The phone app is not an App Store or TestFlight download. Build it from the repository and pair it with a desktop that is already running.")}
        </p>
        <a href="/docs/guides/companion-pairing" class="pressable mt-4 inline-flex text-[14px] font-semibold text-terminal-accent">{text(locale, "Companion pairing")}</a>
        <div class="mt-6 max-w-[400px]"><TopicTile kind="pair" client:only="react" /></div>
      </section>

      <section class="mt-14" aria-labelledby="brand-heading">
        <h2 id="brand-heading" class="font-display text-[1.6rem] font-bold tracking-[-0.03em]">{text(locale, "Brand")}</h2>
        <p class="mt-3 max-w-2xl text-[15px] leading-relaxed text-terminal-muted">{text(locale, "The marks shipped with this site. Download a file directly; there is no separate kit archive.")}</p>
        <ul class="mt-6 grid gap-3 sm:grid-cols-2 lg:grid-cols-4">
          {brand.map((item) => (
            <li class="material rounded-[var(--radius-card)] p-4">
              <img src={`/brand/${item.file}`} alt="" class="h-16 w-auto object-contain" />
              <p class="mt-3 text-[14px] font-semibold">{text(locale, item.label)}</p>
              <a class="mt-1 inline-flex text-[13px] font-semibold text-terminal-accent" href={`/brand/${item.file}`} download>{item.file}</a>
            </li>
          ))}
        </ul>
      </section>

      <p class="mt-14 text-[14px] text-terminal-muted">
        {text(locale, "Developing the app from a clone uses")} <a class="font-semibold text-terminal-accent" href="/docs/guides/quickstart">{text(locale, "Quickstart")}</a>{text(locale, ", not these installers. The asset list and updater limits are described in")} <a class="font-semibold text-terminal-accent" href="/docs/guides/install">{text(locale, "Install")}</a>.
      </p>
    </div>
  </main>
</Layout>

<style>
  .homebrew-command :global(.ss-stage) { user-select: text; }
  .homebrew-command :global(code) { overflow-wrap: anywhere; }
</style>

<script>
  const homebrewCopy = document.querySelector<HTMLButtonElement>("#homebrew-copy")
  const homebrewStatus = document.querySelector<HTMLElement>("#homebrew-copy-status")
  let copyTimer = 0
  homebrewCopy?.addEventListener("click", async () => {
    try {
      await navigator.clipboard.writeText("brew install --cask nikomatt69/tap/cadcamfun")
      const copied = homebrewCopy.dataset.copiedLabel ?? "Copied"
      homebrewCopy.textContent = copied
      if (homebrewStatus) homebrewStatus.textContent = copied
      window.clearTimeout(copyTimer)
      copyTimer = window.setTimeout(() => {
        homebrewCopy.textContent = homebrewCopy.dataset.copyLabel ?? "Copy"
        if (homebrewStatus) homebrewStatus.textContent = ""
      }, 1600)
    } catch {
      // The displayed command remains available to select when clipboard access is unavailable.
    }
  })
</script>
