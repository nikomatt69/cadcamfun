        <tr><td><code>packages/ai/src/nikcli/prompts/</code></td><td>Host prompt text.</td></tr>
        <tr><td><code>packages/ai/src/tools/</code></td><td>Tool modules: <code>cad.ts</code>, <code>cam.ts</code>, <code>library.ts</code>, <code>vcs.ts</code>, <code>registry.ts</code>, <code>handlers.ts</code>.</td></tr>
        <tr><td><code>packages/ai/src/tools/prompts/</code></td><td>Per-tool prompt text.</td></tr>
        <tr><td><code>packages/ai/src/actions/</code></td><td>Action catalogue the desktop and the nikcli plugin share.</td></tr>
        <tr><td><code>packages/ai/src/skills/</code></td><td>Playbooks installed into the isolated host config.</td></tr>
        <tr><td><code>packages/ai/src/prompts/</code></td><td><code>base/</code> and <code>modes/</code> system prompts.</td></tr>
        <tr><td><code>packages/ai/src/direct-model.ts</code></td><td>AI SDK v7 <code>generateText</code> / <code>streamText</code>.</td></tr>
