        <tr><td><code>packages/db/src/migrate.ts</code></td><td>CLI behind <code>bun run db:migrate</code>.</td></tr>
        <tr><td><code>packages/db/src/upgrade.ts</code></td><td>Atomic upgrade runner: snapshot, migrate, roll back the logical schema on failure.</td></tr>
        <tr><td><code>packages/db/src/database.test.ts</code></td><td>Migrates <code>:memory:</code>, round-trips rows, checks foreign keys.</td></tr>
        <tr><td><code>packages/db/src/upgrade.test.ts</code></td><td>WAL snapshot, last-five retention, journal rollback, scoped cleanup.</td></tr>
        <tr><td><code>packages/db/drizzle/</code></td><td>Generated SQL. Do not edit by hand.</td></tr>
