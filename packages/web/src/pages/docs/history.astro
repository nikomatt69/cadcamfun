          <text x="30" y="88">toolpaths/&lt;id&gt;.json</text><text x="300" y="88">materials/&lt;id&gt;.json</text>
          <text x="30" y="110">tools/&lt;id&gt;.json</text><text x="300" y="110">machine-configs/&lt;id&gt;.json</text>
          <text x="30" y="132">costs/&lt;id&gt;.json</text>
          <text x="30" y="154">.cadcamfun/workflows/&lt;name&gt;.yml</text>
