---
export const prerender = true
import DocsLayout from "../../../layouts/DocsLayout.astro"
import DocCallout from "../../../components/docs/DocCallout.astro"
import DocRelated from "../../../components/docs/DocRelated.astro"

const toc = [
  { title: "Two places an account is edited", href: "#surfaces" },
  { title: "Studio sign-in", href: "#studio-signin" },
  { title: "Profile", href: "#profile" },
  { title: "Password", href: "#password" },
  { title: "API keys", href: "#api-keys" },
  { title: "Git identity", href: "#git" },
  { title: "Desktop settings", href: "#desktop" },
