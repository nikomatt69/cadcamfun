import DocRelated from "../../../components/docs/DocRelated.astro"
import captured from "../../../data/api-tour.json"
const capture = (name: string) => captured.find((entry) => entry.name === name)!
const toc = [
  { title: "Environment and captured responses", href: "#environment" },
  { title: "Check health", href: "#health" },
  { title: "Understand authorization", href: "#authorization" },
  { title: "Read and create a project", href: "#projects" },
  { title: "Read back related data", href: "#relations" },
  { title: "Persist a preference", href: "#preferences" },
