  <section id="on-disk" class="doc-section">
    <h2>On disk</h2>
    <p>
      A workflow file is <code>.cadcamfun/workflows/&lt;name&gt;.yml</code>.
    </p>
  </section>

  <section id="step-ids" class="doc-section">
    <h2>Registered step ids</h2>
    <p>
      <code>builtinSteps</code> in <code>apps/sidecar/src/services/workflow-steps.ts</code>.
      Service steps in <code>apps/sidecar/src/services/workflow-service-steps.ts</code> are
      <code>vcsCommitStep</code>, <code>notifyPushStep</code>, and <code>aiPromptStep</code>.
    </p>
    <table>
      <thead>
        <tr><th>Kind</th><th>Step id</th></tr>
      </thead>
      <tbody>
        <tr><td>Builtin</td><td><code>project/validate</code></td></tr>
        <tr><td>Builtin</td><td><code>project/require-gcode</code></td></tr>
        <tr><td>Builtin</td><td><code>cam/verify</code></td></tr>
        <tr><td>Builtin</td><td><code>cam/gcode</code></td></tr>
        <tr><td>Builtin</td><td><code>cam/sequence</code></td></tr>
        <tr><td>Service</td><td><code>vcs/commit</code></td></tr>
        <tr><td>Service</td><td><code>notify/push</code></td></tr>
        <tr><td>Service</td><td><code>ai/prompt</code></td></tr>
      </tbody>
    </table>
  </section>
