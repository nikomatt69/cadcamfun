    <h2>The Mesh type and primitives</h2>
    <DocCode language="ts" title="solid.ts">
{"export interface Mesh {\n  readonly positions: Float32Array   // x, y, z per vertex\n  readonly indices: Uint32Array      // three per triangle, counter-clockwise seen from outside\n}\nexport const meshOf: (solid: Solid, tolerance?: number /* 0.1 mm */) => Mesh\nexport const meshVolume: (mesh: Mesh) => number     // signed; positive when outward-facing\nexport const meshBounds: (mesh: Mesh) => SolidBounds"}
    </DocCode>
