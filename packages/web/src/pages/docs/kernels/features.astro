        <tr><td>M8 × 1.25</td><td>6.4664</td><td>0.7668</td><td>6.6468</td><td>1.0417</td><td>0.1563</td></tr>
        <tr><td>M10 × 1.5</td><td>8.1597</td><td>0.9201</td><td>8.3762</td><td>1.25</td><td>0.1875</td></tr>
        <tr><td>M12 × 1.75</td><td>9.853</td><td>1.0735</td><td>10.1056</td><td>1.4583</td><td>0.2188</td></tr>
        </tbody>
