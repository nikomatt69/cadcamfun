---
export const prerender = true
import "../../../styles/api.css"
import DocsLayout from "../../../layouts/DocsLayout.astro"
import DocCode from "../../../components/docs/DocCode.astro"
import DocRelated from "../../../components/docs/DocRelated.astro"
import ApiOperation from "../../../components/docs/ApiOperation.astro"
import DocViewer3D from "../../../components/docs/DocViewer3D.astro"
import ApiPlayground from "../../../components/docs/ApiPlayground.astro"
import { apiGroups } from "../../../data/apiGroups"
import { operationsFor, referencedSchemas, apiDocument, schemaAnchor, schemaHtml, opAnchor, apiCategories } from "../../../lib/apiReference"
export function getStaticPaths() {
  return apiGroups.map((group) => ({ params: { group: group.slug }, props: { group } }))
}
const { group } = Astro.props
const entries = operationsFor(group)
const schemas = referencedSchemas(entries)
const category = apiCategories.find((c) => c.slugs.includes(group.slug))?.title ?? "API"
// Operations grouped by the first path segment after /api, like the resource sections of the server.
const sectionOf = (path: string) => path.replace(/^\/api\//, "/").split("/").filter(Boolean).slice(0, 2).filter((s) => !s.startsWith("{")).join("/") || path
const sections = [...new Map(entries.map((e) => [sectionOf(e.path), entries.filter((x) => sectionOf(x.path) === sectionOf(e.path))])).entries()]
const sectionId = (name: string) => `section-${name.replace(/[^a-zA-Z0-9]+/g, "-")}`
const isProtected = entries.some((e) => (e.operation.security?.length ?? 0) > 0)
const methodColor: Record<string, string> = { GET: "#2fbf71", POST: "#e0a030", PUT: "#8aa4c8", PATCH: "#a48ac8", DELETE: "#e05050" }
const opSolids = sections.flatMap(([, list], si) => list.map((entry, k) => ({ kind: "box" as const, size: [8, 8, 2.4] as [number, number, number], at: [si * 14, 0, k * 3] as [number, number, number], color: methodColor[entry.method] ?? "#7a8aa0" })))
const opLabels = sections.map(([name, list], si) => ({ text: `/${name} (${list.length})`, at: [si * 14 + 4, -3, list.length * 3 + 2] as [number, number, number], size: 2.6 }))
const toc = [
  { title: "Playground", href: "#playground" },
  { title: "Operations", href: "#operations" },
  ...sections.map(([name]) => ({ title: `/${name}`, href: `#${sectionId(name)}`, depth: 3 })),
  ...(schemas.length ? [{ title: "Schemas", href: "#schemas" }] : []),
  { title: "Calling this group", href: "#group-clients" },
  { title: "Troubleshooting", href: "#group-troubleshooting" },
]
---
<DocsLayout title={group.title} subtitle={group.summary} description={`CADCAMFUN ${group.title} API (${category}): ${entries.length} operations with parameters, typed request and response schemas, SDK and curl examples.`} toc={toc}>
  <div id="playground"><ApiPlayground /></div>

  <section id="operations" class="doc-section">
    <h2>Operations</h2>
    <p>{entries.length} endpoint{entries.length === 1 ? "" : "s"} in the <code>{group.tag}</code> group, generated from the sidecar's own <a href="/docs/api/openapi.json">OpenAPI document</a>. {isProtected ? <>Protected operations take <code>Authorization: Bearer $CADCAMFUN_TOKEN</code>; see <a href="/docs/api#auth">authentication</a>.</> : <>Every operation here is public.</>} Behaviour and limits are in <a href={group.guide}>the subsystem guide</a>.</p>
    <table class="api-index not-prose">
      <tbody>{entries.map((entry) => <tr>
        <td class="api-index-method"><span class={`api-method api-method-${entry.method.toLowerCase()}`}>{entry.method.toLowerCase()}</span></td>
        <td><a href={`#${opAnchor(entry)}`}>{entry.path}</a></td>
        <td class="api-index-id">{entry.operation.operationId}</td>
      </tr>)}</tbody>
    </table>
    <DocViewer3D title={`${group.title} operations in 3D`} caption={`One block per operation (${entries.length}), stacked per resource section of this page and coloured by method: green GET, orange POST, blue PUT, violet PATCH, red DELETE. Generated from the OpenAPI document at build time.`} solids={opSolids} labels={opLabels} height={340} />
  </section>

  {sections.map(([name, list]) => <section id={sectionId(name)} class="doc-section">
    <h2>{`/api/${name}`}</h2>
    {list.map((entry) => <ApiOperation entry={entry} />)}
  </section>)}

  {schemas.length > 0 && <section id="schemas" class="doc-section">
    <h2>Schemas</h2>
    <p>Named schemas reachable from this group's parameters, bodies and responses. A <code>?</code> marks an optional field; <code>| null</code> marks a field that may be present with a null value.</p>
    {schemas.map((name) => <div id={schemaAnchor(name)} class="api-schema-entry not-prose">
      <div class="api-schema-name"><code>{name}</code></div>
      <pre class="api-schema" set:html={schemaHtml(apiDocument.components.schemas[name]!, 0, new Set([name]), false)} />
    </div>)}
  </section>}

  <section id="group-clients" class="doc-section">
    <h2>Calling this group</h2>
    <p>Operation ids have the form <code>{group.tag}.&lt;name&gt;</code>. The generated Promise SDK (<code>@cadcamfun/api/sdk</code>) exposes most of them as <code>client.&lt;namespace&gt;.&lt;method&gt;(input)</code>, where <code>input</code> is one flat object of path parameters and body fields; each card's SDK example shows the exact accessor and input type. Multipart uploads, binary or JavaScript responses and raw webhooks are not generated; those cards show <code>fetch</code> instead.</p>
    <DocCode language="ts" title="Errors from the Promise SDK">
{"import { CadCam, ClientError } from \u0022@cadcamfun/api/sdk\u0022\n\nconst client = CadCam.make({\n  baseUrl: process.env.CADCAMFUN_URL!,\n  headers: { authorization: `Bearer ${process.env.CADCAMFUN_TOKEN}` },\n})\n\ntry {\n  await client.projects.list()\n} catch (error) {\n  if (error instanceof ClientError) {\n    // Transport | UnexpectedStatus | UnsupportedContentType | MalformedResponse | SseEventTooLarge\n  } else {\n    // a declared error body: switch on error._tag\n  }\n}"}
    </DocCode>
  </section>

  <section id="group-troubleshooting" class="doc-section">
    <h2>Troubleshooting</h2>
    <table>
      <thead><tr><th>Symptom</th><th>Likely cause</th><th>Fix</th></tr></thead>
      <tbody>
        <tr><td>401 on every call</td><td>Token from a previous launch, or missing <code>Bearer</code> prefix</td><td>Send <code>Authorization: Bearer &lt;token&gt;</code> with the token the sidecar was started with.</td></tr>
        <tr><td>400 before anything happens</td><td>Body or parameter does not match the schema</td><td>Compare the payload with the request schema on the card.</td></tr>
        <tr><td>403 or 404 on a record you can see elsewhere</td><td>The acting account differs</td><td>Send the right <code>x-session-token</code>, or use the local profile that owns the record.</td></tr>
        <tr><td>409</td><td>Conflicting state, such as a duplicate name or a stale branch head</td><td>Re-read the resource and retry with current data.</td></tr>
        <tr><td>Try it says "blocked by CORS"</td><td>The docs are served from a non-loopback origin</td><td>Run the docs locally or copy the request as curl.</td></tr>
        <tr><td>Connection refused</td><td>The sidecar restarted on a new port</td><td>Read the port from the new <code>ready</code> line.</td></tr>
      </tbody>
    </table>
  </section>

  <DocRelated items={[{ title: "API overview", href: "/docs/api" }, { title: "Subsystem guide", href: group.guide }, { title: "API walkthrough", href: "/docs/guides/api-tour" }]} />
</DocsLayout>
