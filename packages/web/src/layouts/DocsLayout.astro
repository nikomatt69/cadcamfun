---
import "../styles/global.css"
import "../styles/docs.css"
import "../styles/brand.css"
import "../styles/api.css"
import SocialMeta from "../components/SocialMeta.astro"
import Navbar from "../components/Navbar.astro"
import DocsSubnav from "../components/docs/DocsSubnav.astro"
import DocsSidebar from "../components/docs/DocsSidebar.astro"
import DocToc from "../components/docs/DocToc.astro"
import Mark from "../components/Mark.astro"
import DocAssistant from "../components/docs/DocAssistant.astro"
import DocViewerMount from "../components/docs/DocViewerMount.astro"
import LocaleSelector from "../components/LocaleSelector.astro"
import { LOCALE_CODES, localeInfo, localizePath, splitLocalePath } from "../i18n/locales"
import { ui } from "../i18n/ui"

interface TocItem {
  title: string
  href: string
  depth?: number
}
interface Props {
  title?: string
  subtitle?: string
  description?: string
  toc?: TocItem[]
  locale?: import("../i18n/locales").Locale
}
const {
  title = "Documentation",
  subtitle,
  description = "CADCAMFUN architecture and developer documentation.",
  toc = [],
} = Astro.props
const locale = Astro.props.locale ?? Astro.locals.locale ?? "en"
const { pathname: barePath } = splitLocalePath(Astro.url.pathname.replace(/\/$/, "") || "/docs")
const pathname = barePath
const dir = localeInfo(locale).dir
---

<!doctype html>
<html lang={locale} dir={dir} class="docs-root">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#e2eaf4" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#000000" media="(prefers-color-scheme: dark)" />
    <title>{title} — CADCAMFUN Docs</title>
    <meta name="description" content={description} />
    <SocialMeta title={`${title} — CADCAMFUN Docs`} description={description} />
    {LOCALE_CODES.map((code) => <link rel="alternate" hreflang={code} href={new URL(localizePath(barePath, code), Astro.site ?? Astro.url.origin).toString()} />)}
    <link rel="alternate" hreflang="x-default" href={new URL(barePath, Astro.site ?? Astro.url.origin).toString()} />
    <script is:inline define:vars={{ locale, barePath }}>
      // Static English pages are served as assets, before any Worker runs:
      // apply the same choice > browser-language detection here so a first
      // visit lands on the localized page. Country (CF-IPCountry) detection
      // happens in middleware wherever the Worker serves the request.
      (() => {
        if (locale !== "en") return
        if (!barePath.startsWith("/docs")) return
        if (new URLSearchParams(location.search).has("lang")) return
        const cookie = document.cookie.split(";").map((p) => p.trim()).find((p) => p.startsWith("cadcamfun_locale="))?.split("=")[1]
        const codes = ["it", "de", "es", "fr", "pt", "ru", "ja", "hi", "ar"]
        const fromTag = (tag) => {
          if (!tag) return null
          if (tag.toLowerCase().startsWith("zh")) return "zh-CN"
          const primary = tag.split("-")[0].toLowerCase()
          return codes.includes(primary) ? primary : null
        }
        const chosen = cookie && (cookie === "en" || cookie === "zh-CN" || codes.includes(cookie)) ? cookie : null
        const detected = chosen ?? (navigator.languages ?? [navigator.language]).map(fromTag).find(Boolean) ?? "en"
        if (detected !== "en") {
          document.cookie = `cadcamfun_locale=${detected}; Path=/; Max-Age=31536000; SameSite=Lax`
          location.replace(`/${detected}${barePath}${location.search}${location.hash}`)
        }
      })()
    </script>
    <script is:inline>
      (() => {
        const stored = localStorage.getItem("theme")
        const dark = window.matchMedia("(prefers-color-scheme: dark)").matches
        document.documentElement.setAttribute("data-theme", stored || (dark ? "dark" : "light"))
      })()
    </script>
  </head>
  <body class="flex min-h-screen flex-col">
    <a class="sr-only focus:not-sr-only focus:fixed focus:left-[var(--nav-inset)] focus:top-[var(--nav-inset)] focus:z-[100] focus:rounded-[6px] focus:bg-terminal-text focus:px-4 focus:py-2 focus:text-terminal-bg" href="#main-content">{ui(locale, "skip")}</a>
    <Navbar />
    <DocsSubnav />
    <div class="page-shell flex w-full flex-1 flex-col xl:flex-row xl:gap-8">
      <div class="glass-bar sticky top-[var(--chrome-top)] z-30 flex h-[var(--docs-mobilebar-height)] items-center justify-between px-3 xl:hidden">
        <span class="text-sm font-semibold">{ui(locale, "docs")}</span>
        <button id="mobile-docs-toggle" type="button" class="pressable glass-chip px-3 py-1.5 text-sm font-semibold" aria-expanded="false" aria-controls="docs-sidebar" data-browse={ui(locale, "browse")} data-close={ui(locale, "close")}>
          {ui(locale, "browse")}
        </button>
      </div>
      <DocsSidebar />
      <main id="main-content" class="min-w-0 flex-1 py-10 xl:px-2" tabindex="-1">
        <article data-llm-document class="prose mx-auto max-w-[46rem]">
          <header class="not-prose mb-10">
            <p data-llm-exclude class="mb-4 inline-flex items-center gap-2 font-mono text-eyebrow uppercase text-terminal-accent">
              <img src="/brand/icon.png" alt="" width="16" height="16" class="h-4 w-4" />
              {ui(locale, "documentation")}
            </p>
            <h1 class="font-display text-page-title text-terminal-text">{title}</h1>
            {subtitle && <p class="mt-4 max-w-2xl text-page-subtitle text-terminal-muted">{subtitle}</p>}
            <div class="plate-rule" aria-hidden="true"></div>
          </header>
          <div class="content-body">
            <slot />
          </div>
        </article>
      </main>
      {toc.length > 0 && (
        <div class="hidden w-56 shrink-0 xl:block">
          <div class="sticky top-[var(--chrome-top)] pt-10">
        <DocToc items={toc} locale={locale} />
          </div>
        </div>
      )}
    </div>
    <footer class="mt-auto w-full px-[var(--nav-inset)] pb-[var(--nav-inset)] pt-[var(--plate-gap)]">
      <div class="glass-bar mx-auto w-full max-w-[var(--content-max)] py-6">
        <div class="page-shell flex flex-col items-start justify-between gap-4 sm:flex-row sm:items-center">
          <a href="/" aria-label={ui(locale, "home")}><Mark class="h-7 w-auto" /></a>
          <p class="text-[13px] text-terminal-muted">CADCAMFUN · {ui(locale, "footer")}</p>
          <LocaleSelector locale={locale} />
        </div>
      </div>
    </footer>
    <DocAssistant pathname={pathname} />
    <DocViewerMount />
    <script>
      const pg = document.querySelector<HTMLElement>("[data-api-playground]")
      if (pg) {
        const KEY = "cadcamfun.api.playground"
        const msg = (name: string, fallback: string) =>
          pg.querySelector<HTMLElement>(`[data-pg-msg="${name}"]`)?.textContent?.replace(/\s+/g, " ").trim() || fallback
        type Conn = { baseUrl?: string; token?: string; session?: string }
        const load = (): Conn => { try { return JSON.parse(localStorage.getItem(KEY) ?? "{}") as Conn } catch { return {} } }
        const save = (c: Conn) => localStorage.setItem(KEY, JSON.stringify(c))
        const headersOf = (c: Conn, json: boolean): Record<string, string> => ({
          ...(c.token ? { authorization: `Bearer ${c.token}` } : {}),
          ...(c.session ? { "x-session-token": c.session } : {}),
          ...(json ? { "content-type": "application/json" } : {}),
        })
        const inputs = [...pg.querySelectorAll<HTMLInputElement>("[data-pg-input]")]
        const state = pg.querySelector<HTMLElement>("[data-pg-state]")!
        const label = pg.querySelector<HTMLElement>("[data-pg-state-label]")!
        const hint = pg.querySelector<HTMLElement>("[data-pg-hint]")!
        const conn = load()
        for (const input of inputs) {
          const k = input.dataset.pgInput as keyof Conn
          input.value = conn[k] ?? ""
          input.addEventListener("change", () => { const c = load(); c[k] = input.value.trim(); save(c) })
        }
        const set = (s: string, text: string) => { state.dataset.pgState = s; label.textContent = text }
        pg.querySelector("[data-pg-connect]")!.addEventListener("click", async () => {
          const c = load()
          if (!c.baseUrl) { hint.hidden = false; hint.textContent = msg("need-url", "Enter the sidecar URL first."); return }
          set("busy", msg("checking", "Checking…"))
          try {
            const r = await fetch(new URL("/health", c.baseUrl), { headers: headersOf(c, false) })
            set(r.ok ? "ok" : "error", r.ok ? msg("connected", "Connected") : `HTTP ${r.status}`)
            hint.hidden = r.ok
            if (!r.ok) hint.textContent = r.status === 401
              ? msg("auth", "The sidecar answered 401: check the bearer token.")
              : msg("status", "The sidecar answered {status}.").replaceAll("{status}", String(r.status))
          } catch {
            set("error", msg("unreachable", "Unreachable"))
            hint.hidden = false
            hint.textContent = msg("cors", "No response. Check the URL and port; from a non-loopback origin the browser blocks the request (CORS).")
          }
        })
        pg.querySelector("[data-pg-clear]")!.addEventListener("click", () => { localStorage.removeItem(KEY); inputs.forEach((i) => (i.value = "")); set("idle", msg("idle", "Not connected")) })
        const build = (form: HTMLElement): { url: string; init: RequestInit; curl: string } | string => {
          const c = load()
          if (!c.baseUrl) return msg("need-base", "Set the base URL in the playground at the top of the page.")
          let path = form.dataset.path ?? "/"
          const query = new URLSearchParams()
          const headers = headersOf(c, form.dataset.media === "application/json")
          for (const input of form.querySelectorAll<HTMLInputElement>("[data-try-param]")) {
            const v = input.value.trim()
            if (!v) continue
            if (input.dataset.tryIn === "path") path = path.replace(`{${input.dataset.tryParam}}`, encodeURIComponent(v))
            else if (input.dataset.tryIn === "header") headers[input.dataset.tryParam!] = v
            else query.set(input.dataset.tryParam!, v)
          }
          if (/\{[^}]+\}/.test(path)) return msg("need-path", "Fill in every path parameter.")
          const url = new URL(path, c.baseUrl)
          query.forEach((v, k) => url.searchParams.set(k, v))
          const body = form.querySelector<HTMLTextAreaElement>("[data-try-body]")?.value
          const method = form.dataset.method ?? "GET"
          const init: RequestInit = { method, headers, ...(body && method !== "GET" ? { body } : {}) }
          const curl = [`curl -sS -X ${method} '${url}'`, ...Object.entries(headers).map(([k, v]) => `  -H '${k}: ${k === "authorization" ? "Bearer $CADCAMFUN_TOKEN" : v}'`), ...(init.body ? [`  --data '${String(init.body).replace(/'/g, "'\\''")}'`] : [])].join(" \\\n")
          return { url: url.toString(), init, curl }
        }
        for (const form of document.querySelectorAll<HTMLElement>("[data-api-try]")) {
          const note = form.querySelector<HTMLElement>("[data-try-note]")!
          form.querySelector("[data-try-curl]")!.addEventListener("click", async () => {
            const b = build(form)
            if (typeof b === "string") { note.textContent = b; return }
            await navigator.clipboard?.writeText(b.curl)
            note.textContent = msg("copied", "Copied")
          })
          form.querySelector("[data-try-send]")!.addEventListener("click", async () => {
            const b = build(form)
            if (typeof b === "string") { note.textContent = b; return }
            const result = form.querySelector<HTMLElement>("[data-try-result]")!
            const status = form.querySelector<HTMLElement>("[data-try-status]")!
            note.textContent = msg("sending", "Sending…")
            const t0 = performance.now()
            try {
              const r = await fetch(b.url, b.init)
              const text = await r.text()
              let shown = text
              try { shown = JSON.stringify(JSON.parse(text), null, 2) } catch {}
              status.textContent = String(r.status)
              status.className = `api-pill api-pill-status-${String(r.status)[0]}`
              form.querySelector<HTMLElement>("[data-try-output]")!.textContent = shown.slice(0, 20000)
              note.textContent = ""
            } catch {
              status.textContent = msg("failed", "failed")
              status.className = "api-pill api-pill-status-5"
              form.querySelector<HTMLElement>("[data-try-output]")!.textContent = msg("request-failed", "The request failed before a response: wrong URL, sidecar stopped, or blocked by CORS.")
              note.textContent = ""
            }
            form.querySelector<HTMLElement>("[data-try-timing]")!.textContent = `${Math.round(performance.now() - t0)} ms`
            form.querySelector<HTMLElement>("[data-try-url]")!.textContent = b.url
            result.hidden = false
          })
        }
      }
    </script>
    <script>
      document.querySelectorAll<HTMLButtonElement>("[data-doc-code-copy]").forEach((button) => {
        let timer = 0
        button.addEventListener("click", async () => {
          const code = button.closest("figure")?.querySelector("pre code")?.textContent ?? ""
          try {
            await navigator.clipboard.writeText(code)
          } catch {
            return
          }
          button.setAttribute("data-copied", "")
          button.setAttribute("aria-label", button.dataset.labelCopied ?? "Copied")
          window.clearTimeout(timer)
          timer = window.setTimeout(() => {
            button.removeAttribute("data-copied")
            button.setAttribute("aria-label", button.dataset.labelCopy ?? "Copy code")
          }, 1600)
        })
      })
    </script>
    <script>
      const button = document.getElementById("mobile-docs-toggle")
      const sidebar = document.getElementById("docs-sidebar")
      button?.addEventListener("click", () => {
        const open = button.getAttribute("aria-expanded") === "true"
        button.setAttribute("aria-expanded", open ? "false" : "true")
        button.textContent = open ? button.dataset.browse ?? "Browse" : button.dataset.close ?? "Close"
        sidebar?.classList.toggle("hidden", open)
        sidebar?.classList.toggle("docs-rail-open", !open)
      })
    </script>
  </body>
</html>
