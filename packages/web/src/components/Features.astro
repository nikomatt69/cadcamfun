---
import { apps, packages } from "../data/architecture"
---

<section class="page-section" aria-labelledby="suite-heading">
  <div class="page-shell">
    <p class="font-mono text-eyebrow uppercase text-terminal-accent">Workspace</p>
    <h2 id="suite-heading" class="font-display mt-3 max-w-xl text-[clamp(1.8rem,3vw,2.6rem)] font-bold tracking-[-0.035em]">
      Packages own the model. Apps own the window.
    </h2>
    <div class="mt-10 grid gap-3 sm:grid-cols-2 lg:grid-cols-4">
      {packages.map((item) => (
        <a href="/docs/packages" class="lift pressable material block rounded-[var(--radius-card)] p-5">
          <p class="font-mono text-[11px] uppercase tracking-[0.14em] text-terminal-accent">{item.role}</p>
          <h3 class="font-display mt-3 text-[1.05rem] font-bold tracking-tight">{item.name.replace("@cadcamfun/", "")}</h3>
          <p class="mt-2 text-[13.5px] leading-relaxed text-terminal-muted">{item.owns}</p>
        </a>
      ))}
    </div>
    <div class="mt-3 grid gap-3 md:grid-cols-3">
      {apps.map((item) => (
        <a href="/docs/architecture" class="lift pressable material block rounded-[var(--radius-card)] p-5">
          <p class="font-mono text-[11px] uppercase tracking-[0.14em] text-terminal-text">{item.role}</p>
          <h3 class="font-display mt-3 text-[1.05rem] font-bold tracking-tight">{item.path}</h3>
          <p class="mt-2 text-[13.5px] leading-relaxed text-terminal-muted">{item.owns}</p>
        </a>
      ))}
    </div>
  </div>
</section>
