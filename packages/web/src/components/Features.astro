---
import { apps, packages } from "../data/architecture"
import { text } from "../i18n/catalog"
import WorkspaceCards from "./stage/WorkspaceCards"

const locale = Astro.locals.locale ?? "en"
const packageItems = packages.map((item) => ({ title: item.name.replace("@cadcamfun/", ""), role: text(locale, item.role), owns: text(locale, item.owns), href: "/docs/packages" }))
const appItems = apps.map((item) => ({ title: item.path, role: text(locale, item.role), owns: text(locale, item.owns), href: "/docs/architecture" }))
---

<section class="page-section" aria-labelledby="suite-heading">
  <div class="page-shell">
    <p class="font-mono text-eyebrow uppercase text-terminal-accent">{text(locale, "Workspace")}</p>
    <h2 id="suite-heading" class="font-display mt-3 max-w-xl text-[clamp(1.8rem,3vw,2.6rem)] font-bold tracking-[-0.035em]">
      {text(locale, "Packages own the model. Apps own the window.")}
    </h2>
    <div class="mt-10 max-w-[1000px]">
      <WorkspaceCards client:load packages={packageItems} apps={appItems} heading={[text(locale, "Workspace"), text(locale, "Apps")]} />
    </div>
  </div>
</section>
