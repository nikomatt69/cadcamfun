---
/**
 * Interactive 3D preview for documentation examples. Renders a declarative scene
 * (extruded profiles, boxes, cylinders, toolpath polylines) with three.js and orbit controls.
 * Coordinates are millimetres, Z up, matching the CADCAMFUN core conventions.
 */
import "../../stageshow/kit/stage.css"
import { Window } from "../../stageshow/kit/window"

export interface ViewerSolid {
  kind: "box" | "extrude" | "cylinder" | "sphere" | "mesh"
  /** box: [x, y, z] size, placed with its minimum corner at `at`. */
  size?: [number, number, number]
  /** extrude: outer ring [[x, y], ...] (counter-clockwise) and optional holes. */
  profile?: [number, number][]
  holes?: [number, number][][]
  height?: number
  /** cylinder: radius and height, axis along Z, base centre at `at`. */
  radius?: number
  at?: [number, number, number]
  /** mesh: flat [x, y, z, ...] vertex positions and triangle indices, e.g. a kernel's Mesh output. */
  positions?: number[]
  indices?: number[]
  color?: string
  opacity?: number
}
export interface ViewerLabel {
  text: string
  at: [number, number, number]
  color?: string
  /** Text height in scene units (default 4). */
  size?: number
}
export interface ViewerPath {
  /** Polyline points [x, y, z]. */
  points: [number, number, number][]
  rapid?: boolean
  color?: string
}
interface Props {
  title: string
  caption?: string
  solids?: ViewerSolid[]
  paths?: ViewerPath[]
  labels?: ViewerLabel[]
  height?: number
  animate?: boolean
}
const { title, caption, solids = [], paths = [], labels = [], height = 340, animate = false } = Astro.props
const scene = JSON.stringify({ solids, paths, labels, animate })
---

<figure class="ss-stage doc-viewer3d not-prose my-6" data-scene={scene}>
  <Window title={title} className="doc-viewer3d-window">
    <div class="doc-viewer3d-help">Drag to orbit · scroll to zoom · right-drag to pan</div>
    <div class="doc-viewer3d-canvas" style={`height:${height}px;position:relative`}>
      <noscript><p class="p-3 text-[13px]">Enable JavaScript to view this interactive 3D example.</p></noscript>
    </div>
    {animate && <div class="doc-viewer3d-actions"><button type="button" class="doc-viewer3d-play">Replay toolpath</button></div>}
  </Window>
  {caption && <figcaption class="doc-viewer3d-caption">{caption}</figcaption>}
</figure>

