---
/**
 * Interactive 3D preview for documentation examples. Renders a declarative scene
 * (extruded profiles, boxes, cylinders, toolpath polylines) with three.js and orbit controls.
 * Coordinates are millimetres, Z up, matching the CADCAMFUN core conventions.
 */
export interface ViewerSolid {
  kind: "box" | "extrude" | "cylinder"
  /** box: [x, y, z] size, placed with its minimum corner at `at`. */
  size?: [number, number, number]
  /** extrude: outer ring [[x, y], ...] (counter-clockwise) and optional holes. */
  profile?: [number, number][]
  holes?: [number, number][][]
  height?: number
  /** cylinder: radius and height, axis along Z, base centre at `at`. */
  radius?: number
  at?: [number, number, number]
  color?: string
  opacity?: number
}
export interface ViewerPath {
  /** Polyline points [x, y, z]. */
  points: [number, number, number][]
  rapid?: boolean
  color?: string
}
interface Props {
  title: string
  caption?: string
  solids?: ViewerSolid[]
  paths?: ViewerPath[]
  height?: number
  animate?: boolean
}
const { title, caption, solids = [], paths = [], height = 340, animate = false } = Astro.props
const scene = JSON.stringify({ solids, paths, animate })
---

<figure class="doc-viewer3d not-prose my-6 rounded-[var(--radius-md)] border border-terminal-border bg-terminal-panel" data-scene={scene}>
  <div class="flex items-center justify-between px-3 py-2 text-[12px] text-terminal-muted">
    <span class="font-display font-bold text-terminal-text">{title}</span>
    <span>Drag to orbit · scroll to zoom · right-drag to pan</span>
  </div>
  <div class="doc-viewer3d-canvas" style={`height:${height}px;position:relative`}>
    <noscript><p class="p-3 text-[13px]">Enable JavaScript to view this interactive 3D example.</p></noscript>
  </div>
  {animate && <div class="px-3 pb-2"><button type="button" class="doc-viewer3d-play rounded border border-terminal-border px-2 py-1 text-[12px]">Replay toolpath</button></div>}
  {caption && <figcaption class="px-3 pb-3 text-[13px] text-terminal-muted">{caption}</figcaption>}
</figure>

<script>
  import * as THREE from "three"
  import { OrbitControls } from "three/examples/jsm/controls/OrbitControls.js"

  type Solid = { kind: string; size?: number[]; profile?: number[][]; holes?: number[][][]; height?: number; radius?: number; at?: number[]; color?: string; opacity?: number }
  type Path = { points: number[][]; rapid?: boolean; color?: string }

  const mount = (figure: HTMLElement) => {
    if (figure.dataset.mounted) return
    figure.dataset.mounted = "1"
    const host = figure.querySelector<HTMLElement>(".doc-viewer3d-canvas")!
    const data = JSON.parse(figure.dataset.scene ?? "{}") as { solids: Solid[]; paths: Path[]; animate: boolean }
    let renderer: THREE.WebGLRenderer
    try {
      renderer = new THREE.WebGLRenderer({ antialias: true, alpha: true })
    } catch {
      host.innerHTML = "<p style='padding:12px;font-size:13px'>WebGL is not available in this browser.</p>"
      return
    }
    renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2))
    host.appendChild(renderer.domElement)
    const scene = new THREE.Scene()
    THREE.Object3D.DEFAULT_UP.set(0, 0, 1)
    const camera = new THREE.PerspectiveCamera(40, 1, 0.1, 10000)
    camera.up.set(0, 0, 1)
    scene.add(new THREE.HemisphereLight(0xffffff, 0x445566, 1.6))
    const sun = new THREE.DirectionalLight(0xffffff, 1.4)
    sun.position.set(80, -120, 160)
    scene.add(sun)

    const group = new THREE.Group()
    for (const s of data.solids) {
      let geometry: THREE.BufferGeometry | undefined
      const at = s.at ?? [0, 0, 0]
      if (s.kind === "box" && s.size) {
        geometry = new THREE.BoxGeometry(s.size[0], s.size[1], s.size[2])
        geometry.translate(at[0] + s.size[0] / 2, at[1] + s.size[1] / 2, at[2] + s.size[2] / 2)
      } else if (s.kind === "cylinder" && s.radius && s.height) {
        geometry = new THREE.CylinderGeometry(s.radius, s.radius, s.height, 48)
        geometry.rotateX(Math.PI / 2)
        geometry.translate(at[0], at[1], at[2] + s.height / 2)
      } else if (s.kind === "extrude" && s.profile) {
        const shape = new THREE.Shape(s.profile.map(([x, y]) => new THREE.Vector2(x, y)))
        for (const hole of s.holes ?? []) shape.holes.push(new THREE.Path(hole.map(([x, y]) => new THREE.Vector2(x, y))))
        geometry = new THREE.ExtrudeGeometry(shape, { depth: s.height ?? 1, bevelEnabled: false, curveSegments: 32 })
        geometry.translate(at[0], at[1], at[2])
      }
      if (!geometry) continue
      const material = new THREE.MeshStandardMaterial({ color: s.color ?? "#8aa4c8", metalness: 0.2, roughness: 0.55, transparent: (s.opacity ?? 1) < 1, opacity: s.opacity ?? 1 })
      const mesh = new THREE.Mesh(geometry, material)
      group.add(mesh)
      group.add(new THREE.LineSegments(new THREE.EdgesGeometry(geometry, 25), new THREE.LineBasicMaterial({ color: 0x1b2430 })))
    }
    const pathLines: THREE.Line[] = []
    for (const p of data.paths) {
      const geometry = new THREE.BufferGeometry().setFromPoints(p.points.map(([x, y, z]) => new THREE.Vector3(x, y, z)))
      const material = p.rapid
        ? new THREE.LineDashedMaterial({ color: p.color ?? "#e0a030", dashSize: 1.5, gapSize: 1 })
        : new THREE.LineBasicMaterial({ color: p.color ?? "#2fbf71" })
      const line = new THREE.Line(geometry, material)
      if (p.rapid) line.computeLineDistances()
      pathLines.push(line)
      group.add(line)
    }
    scene.add(group)

    const box = new THREE.Box3().setFromObject(group)
    const size = box.getSize(new THREE.Vector3())
    const center = box.getCenter(new THREE.Vector3())
    const radius = Math.max(size.length() / 2, 1)
    const grid = new THREE.GridHelper(Math.ceil(radius * 3), 20, 0x5a6878, 0x3a4652)
    grid.rotateX(Math.PI / 2)
    grid.position.set(center.x, center.y, box.min.z - 0.01)
    scene.add(grid)
    scene.add(new THREE.AxesHelper(radius * 0.6))
    camera.position.set(center.x + radius * 1.6, center.y - radius * 2.2, center.z + radius * 1.5)
    const controls = new OrbitControls(camera, renderer.domElement)
    controls.target.copy(center)
    controls.enableDamping = true
    controls.update()

    const resize = () => {
      const w = host.clientWidth, h = host.clientHeight
      renderer.setSize(w, h)
      camera.aspect = w / Math.max(h, 1)
      camera.updateProjectionMatrix()
    }
    new ResizeObserver(resize).observe(host)
    resize()

    // Toolpath replay: reveal the path vertices progressively.
    const total = pathLines.reduce((n, l) => n + l.geometry.attributes.position!.count, 0)
    let shown = data.animate ? 0 : total
    const reveal = () => {
      let left = shown
      for (const l of pathLines) {
        const c = l.geometry.attributes.position!.count
        l.geometry.setDrawRange(0, Math.max(0, Math.min(c, left)))
        left -= c
      }
    }
    figure.querySelector(".doc-viewer3d-play")?.addEventListener("click", () => { shown = 0 })
    const loop = () => {
      if (shown < total) { shown = Math.min(total, shown + Math.max(1, total / 240)); reveal() }
      controls.update()
      renderer.render(scene, camera)
      requestAnimationFrame(loop)
    }
    reveal()
    loop()
  }

  const io = new IntersectionObserver((entries) => {
    for (const e of entries) if (e.isIntersecting) { mount(e.target as HTMLElement); io.unobserve(e.target) }
  })
  document.querySelectorAll<HTMLElement>(".doc-viewer3d").forEach((f) => io.observe(f))
</script>
