---
import { activeDocsSection, docsNav } from "../../data/docsSidebar"
import { localizePath, splitLocalePath } from "../../i18n/locales"
import { navTitle, ui } from "../../i18n/ui"

const locale = Astro.locals.locale ?? "en"
const { pathname } = splitLocalePath(Astro.url.pathname.replace(/\/$/, "") || "/docs")
const active = activeDocsSection(pathname)
---

<div class="sticky top-[var(--subnav-top)] z-40 w-full">
  <div class="px-[var(--nav-inset)]">
    <div class="docs-subnav glass-bar mx-auto w-full max-w-[var(--content-max)]">
      <nav class="page-shell custom-scrollbar flex h-[var(--docs-subnav-height)] items-center gap-1 overflow-x-auto" aria-label={ui(locale, "docsAreas")}>
        {docsNav.map((section) => (
          <a href={localizePath(section.href, locale)} class="docs-subnav-link shrink-0" aria-current={section.id === active.id ? "page" : undefined}>
            {navTitle(section.title, locale)}
          </a>
        ))}
      </nav>
    </div>
  </div>
  <div class="field-mask h-[var(--plate-gap)]"></div>
</div>
