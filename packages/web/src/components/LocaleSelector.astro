---
import { LOCALE_CODES, localeInfo, splitLocalePath, type Locale } from "../i18n/locales"
import { ui } from "../i18n/ui"
import LocaleSelect from "./stage/LocaleSelect"

interface Props { locale?: Locale }
const locale: Locale = Astro.props.locale ?? Astro.locals.locale ?? "en"
const { pathname: bare } = splitLocalePath(Astro.url.pathname.replace(/\/$/, "") || "/docs")
const onDocs = bare === "/docs" || bare.startsWith("/docs/")
const options = LOCALE_CODES.map((code) => ({ code, endonym: localeInfo(code).endonym }))
---

<LocaleSelect client:load options={options} locale={locale} bare={bare} onDocs={onDocs} label={ui(locale, "language")} />
