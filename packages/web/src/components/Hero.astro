---
import Mark from "./Mark.astro"

const tools = [
  { src: "/cursors/draw-line.svg", label: "Line" },
  { src: "/cursors/draw-arc.svg", label: "Arc" },
  { src: "/cursors/extrude.svg", label: "Extrude" },
  { src: "/cursors/fillet.svg", label: "Fillet" },
  { src: "/cursors/mill.svg", label: "Mill" },
  { src: "/cursors/drill.svg", label: "Drill" },
  { src: "/cursors/toolpath.svg", label: "Toolpath" },
  { src: "/cursors/measure.svg", label: "Measure" },
]
---

<section class="page-section relative" aria-label="Introduction">
  <div class="page-shell grid items-center gap-12 lg:grid-cols-[minmax(0,1.1fr)_minmax(0,0.9fr)]">
    <div>
      <p class="hero-anim glass-chip mb-6 inline-flex items-center gap-2 px-3 py-1.5 text-[12.5px] font-semibold text-terminal-muted" style="animation-delay: 0ms">
        <img src="/brand/icon.png" alt="" width="18" height="18" class="h-[18px] w-[18px]" />
        Native CAD/CAM · v6
      </p>
      <h1 class="hero-anim mb-6" style="animation-delay: 50ms">
        <Mark class="h-[clamp(5.5rem,16vw,9.5rem)] w-auto" />
        <span class="sr-only">CADCAMFUN</span>
      </h1>
      <p class="hero-anim mb-8 max-w-[34rem] text-[clamp(1.02rem,1.4vw,1.18rem)] leading-[1.65] text-terminal-muted" style="animation-delay: 100ms">
        A local-first desktop app for drawing, modelling, toolpaths, and G-code.
        The geometry stays pure. The sidecar owns I/O. The window is just the shell.
      </p>
      <div class="hero-anim flex flex-col gap-3 sm:flex-row" style="animation-delay: 150ms">
        <a href="/docs" class="pressable lift glass-chip plate-face inline-flex items-center justify-center px-5 py-3 text-[14px] font-bold">
          Read the docs
        </a>
        <a href="/docs/architecture" class="pressable lift glass-chip inline-flex items-center justify-center px-5 py-3 text-[14px] font-semibold text-terminal-text">
          Architecture
        </a>
      </div>
    </div>

    <div class="hero-anim material relative rounded-[var(--radius-card)] p-6 sm:p-8" style="animation-delay: 120ms">
      <div class="flex items-start justify-between gap-4">
        <img src="/brand/icon.png" alt="" width="88" height="88" class="h-[88px] w-[88px]" />
        <span class="font-mono text-[11px] uppercase tracking-[0.16em] text-terminal-muted">local-first</span>
      </div>
      <p class="mt-6 font-display text-[1.35rem] font-bold leading-tight tracking-[-0.03em]">
        Design, model, manufacture.
      </p>
      <p class="mt-2 text-[14.5px] leading-relaxed text-terminal-muted">
        Bun sidecar, Effect services, SQLite on disk, Tauri around the window.
      </p>
      <ul class="mt-6 grid grid-cols-4 gap-2">
        {tools.map((tool) => (
          <li class="glass-chip flex flex-col items-center gap-1.5 px-1 py-3 text-center">
            <img src={tool.src} alt="" width="22" height="22" class="tool-glyph h-[22px] w-[22px]" />
            <span class="text-[10.5px] font-semibold tracking-wide text-terminal-muted">{tool.label}</span>
          </li>
        ))}
      </ul>
    </div>
  </div>
</section>
