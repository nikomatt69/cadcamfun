    <div>
      <p class="font-mono text-eyebrow uppercase text-terminal-text">Quickstart</p>
      <h2 id="start-heading" class="font-display mt-3 text-[clamp(1.8rem,3vw,2.5rem)] font-bold tracking-[-0.035em]">
        One workspace. The desktop opens from here.
