      </p>
      <a href="/docs/guides/quickstart" class="pressable mt-6 inline-flex text-[14px] font-semibold text-terminal-accent">
        Full quickstart
      </a>
    </div>
    <pre class="material min-w-0 rounded-[var(--radius-card)]"><code class="block overflow-x-auto p-5 font-mono text-[13px] leading-7 text-terminal-text">{commands}</code></pre>
