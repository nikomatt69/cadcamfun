{
  "name": "@cadcamfun/web",
  "private": true,
  "version": "0.1.15",
  "description": "CADCAMFUN documentation site and Studio, deployed to Cloudflare.",
  "type": "module",
  "scripts": {
    "dev": "bun script/dev.ts",
    "start": "astro dev",
    "studio": "bun script/studio-server.ts",
    "build": "astro build",
    "preview": "astro preview",
    "deploy": "bun script/deploy.ts",
    "astro": "astro",
    "check:freshness": "bun run check:docs-index && bun run check:api-reference",
    "check:docs-index": "bun run script/check-docs-index.ts",
    "typecheck": "bun check -p tsconfig.json && bun run check:freshness",
    "generate:api-reference": "bun script/generate-api-reference.mjs",
    "check:api-reference": "bun script/generate-api-reference.mjs --check"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^12.0.0",
    "@astrojs/mdx": "^4.3.7",
    "@astrojs/tailwind": "^6.0.2",
    "@cadcamfun/db": "workspace:*",
    "@fontsource/jetbrains-mono": "^5.2.8",
    "@mixmark-io/domino": "^2.2.0",
    "@tailwindcss/typography": "0.5.19",
    "astro": "^5.14.1",
    "drizzle-orm": "1.0.0-beta.22",
    "tailwindcss": "^3.4.17",
    "turndown": "^7.2.4",
    "turndown-plugin-gfm": "^1.0.2",
    "three": "^0.180.0"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/turndown": "^5.0.6",
    "wrangler": "4.103.0",
    "@types/three": "^0.180.0"
  }
}
