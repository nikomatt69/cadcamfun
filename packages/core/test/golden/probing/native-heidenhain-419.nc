0 BEGIN PGM NATIVE MM
1 ; PRESET TABLE ROW 1 = G54 DATUM; MACHINE CALIBRATION REQUIRED
2 CYCL DEF 247 PRESETTING ~
  Q339=+1 ;PRESET NUMBER
3 ;OPERATION: probe
4 TOOL CALL 1 Z
5 L X+0.000 Y+0.000 Z+30.000 R0 FMAX
6 TCH PROBE 419 DATUM IN ONE AXIS ~
  Q263=-5 ;1ST POINT 1ST AXIS ~
  Q264=+20 ;1ST POINT 2ND AXIS ~
  Q261=-5 ;MEASURING HEIGHT ~
  Q320=+3 ;SET-UP CLEARANCE ~
  Q260=+30 ;CLEARANCE HEIGHT ~
  Q272=+1 ;MEASURING AXIS ~
  Q267=+1 ;TRAVERSE DIRECTION ~
  Q305=+1 ;NUMBER IN TABLE ~
  Q333=+0 ;DATUM ~
  Q303=+1 ;MEAS. VALUE TRANSFER
7 L X-5.000 Y+20.000 Z+30.000 R0 FMAX M5 M30
8 END PGM NATIVE MM
