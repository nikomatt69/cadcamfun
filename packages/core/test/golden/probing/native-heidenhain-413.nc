0 BEGIN PGM NATIVE MM
1 ; PRESET TABLE ROW 1 = G54 DATUM; MACHINE CALIBRATION REQUIRED
2 CYCL DEF 247 PRESETTING ~
  Q339=+1 ;PRESET NUMBER
3 ;OPERATION: probe
4 TOOL CALL 1 Z
5 L X+0.000 Y+0.000 Z+30.000 R0 FMAX
6 TCH PROBE 413 DATUM OUTSIDE CIRCLE ~
  Q321=+75 ;CENTER 1ST AXIS ~
  Q322=+30 ;CENTER 2ND AXIS ~
  Q262=+16 ;NOMINAL DIAMETER ~
  Q325=+0 ;STARTING ANGLE ~
  Q247=+90 ;STEPPING ANGLE ~
  Q261=+5 ;MEASURING HEIGHT ~
  Q320=+3 ;SET-UP CLEARANCE ~
  Q260=+30 ;CLEARANCE HEIGHT ~
  Q301=+1 ;MOVE TO CLEARANCE ~
  Q305=+1 ;NUMBER IN TABLE ~
  Q331=+75 ;DATUM ~
  Q332=+30 ;DATUM ~
  Q303=+1 ;MEAS. VALUE TRANSFER ~
  Q381=+0 ;PROBE IN TS AXIS ~
  Q382=+0 ;1ST CO. FOR TS AXIS ~
  Q383=+0 ;2ND CO. FOR TS AXIS ~
  Q384=+0 ;3RD CO. FOR TS AXIS ~
  Q333=+0 ;DATUM ~
  Q423=+4 ;NO. OF PROBE POINTS ~
  Q365=+1 ;TYPE OF TRAVERSE
7 L X+75.000 Y+30.000 Z+30.000 R0 FMAX M5 M30
8 END PGM NATIVE MM
