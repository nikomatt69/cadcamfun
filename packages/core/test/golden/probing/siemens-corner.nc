%_N_PROBE_SIEMENS_MPF
;$PATH=/_N_MPF_DIR
G71 G90 G17 G94 G40 G64
G505
;OPERATION: PROBE
T1 M6
D1
G0 X0.000 Y0.000 Z30.000
MEAS=1 G1 X-5.000 Y7.000 F2000
STOPRE
IF $AC_MEA[1]==1
MSG("THE PROBE TOUCHED DURING A PROTECTED MOVE")
SETAL(61992)
M0
ENDIF
MEAS=1 G1 X-5.000 Y7.000 Z-7.000 F2000
STOPRE
IF $AC_MEA[1]==1
MSG("THE PROBE TOUCHED DURING A PROTECTED MOVE")
SETAL(61992)
M0
ENDIF
G91 MEAS=1 G1 X9.000 F500
G90
STOPRE
IF $AC_MEA[1]==0
MSG("THE PROBE DID NOT TOUCH")
SETAL(61991)
M0
ENDIF
R100=$AA_MW[X]
MEAS=1 G1 X=R100-1 Y7.000 Z-7.000 F2000
STOPRE
IF $AC_MEA[1]==1
MSG("THE PROBE TOUCHED DURING A PROTECTED MOVE")
SETAL(61992)
M0
ENDIF
G91 MEAS=1 G1 X7.000 F100
G90
STOPRE
IF $AC_MEA[1]==0
MSG("THE PROBE DID NOT TOUCH")
SETAL(61991)
M0
ENDIF
R101=$AA_MW[X]
R102=$AA_MW[Y]
MEAS=1 G1 X-5.000 Y7.000 Z-7.000 F2000
STOPRE
IF $AC_MEA[1]==1
MSG("THE PROBE TOUCHED DURING A PROTECTED MOVE")
SETAL(61992)
M0
ENDIF
MEAS=1 G1 X-5.000 Y7.000 Z30.000 F2000
STOPRE
IF $AC_MEA[1]==1
MSG("THE PROBE TOUCHED DURING A PROTECTED MOVE")
SETAL(61992)
M0
ENDIF
MEAS=1 G1 X7.000 Y-5.000 F2000
STOPRE
IF $AC_MEA[1]==1
MSG("THE PROBE TOUCHED DURING A PROTECTED MOVE")
SETAL(61992)
M0
ENDIF
MEAS=1 G1 X7.000 Y-5.000 Z-7.000 F2000
STOPRE
IF $AC_MEA[1]==1
MSG("THE PROBE TOUCHED DURING A PROTECTED MOVE")
SETAL(61992)
M0
ENDIF
G91 MEAS=1 G1 Y9.000 F500
G90
STOPRE
IF $AC_MEA[1]==0
MSG("THE PROBE DID NOT TOUCH")
SETAL(61991)
M0
ENDIF
R103=$AA_MW[Y]
MEAS=1 G1 X7.000 Y=R103-1 Z-7.000 F2000
STOPRE
IF $AC_MEA[1]==1
MSG("THE PROBE TOUCHED DURING A PROTECTED MOVE")
SETAL(61992)
M0
ENDIF
G91 MEAS=1 G1 Y7.000 F100
G90
STOPRE
IF $AC_MEA[1]==0
MSG("THE PROBE DID NOT TOUCH")
SETAL(61991)
M0
ENDIF
R104=$AA_MW[X]
R105=$AA_MW[Y]
MEAS=1 G1 X7.000 Y-5.000 Z-7.000 F2000
STOPRE
IF $AC_MEA[1]==1
MSG("THE PROBE TOUCHED DURING A PROTECTED MOVE")
SETAL(61992)
M0
ENDIF
;VARIABLE prx = R106
R106=R101+2
;VARIABLE pry = R107
R107=R105+2
MEAS=1 G1 X7.000 Y-5.000 Z30.000 F2000
STOPRE
IF $AC_MEA[1]==1
MSG("THE PROBE TOUCHED DURING A PROTECTED MOVE")
SETAL(61992)
M0
ENDIF
;VARIABLE pro0lX = R108
R108=R106
;VARIABLE pro0lY = R109
R109=R107
;VARIABLE pro0lm = R110
R110=SQRT((R108*R108)+(R109*R109))
$P_UIFR[5,X,TR]=$P_UIFR[5,X,TR]+R108
G505
$P_UIFR[5,Y,TR]=$P_UIFR[5,Y,TR]+R109
G505
M5
M30
