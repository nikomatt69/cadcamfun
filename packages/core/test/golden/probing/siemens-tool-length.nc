%_N_PROBE_SIEMENS_MPF
;$PATH=/_N_MPF_DIR
G71 G90 G17 G94 G40 G64
G54
;OPERATION: PROBE
T1 M6
D1
G0 X300.000 Y-50.000 Z200.000
MEAS=1 G1 X300.000 Y-50.000 F2000
STOPRE
IF $AC_MEA[1]==1
MSG("THE PROBE TOUCHED DURING A PROTECTED MOVE")
SETAL(61992)
M0
ENDIF
MEAS=1 G1 X300.000 Y-50.000 Z150.000 F2000
STOPRE
IF $AC_MEA[1]==1
MSG("THE PROBE TOUCHED DURING A PROTECTED MOVE")
SETAL(61992)
M0
ENDIF
G91 MEAS=1 G1 Z-146.000 F800
G90
STOPRE
IF $AC_MEA[1]==0
MSG("THE PROBE DID NOT TOUCH")
SETAL(61991)
M0
ENDIF
R100=$AA_MW[Z]
MEAS=1 G1 X300.000 Y-50.000 Z=R100-(-1) F2000
STOPRE
IF $AC_MEA[1]==1
MSG("THE PROBE TOUCHED DURING A PROTECTED MOVE")
SETAL(61992)
M0
ENDIF
G91 MEAS=1 G1 Z-7.000 F60
G90
STOPRE
IF $AC_MEA[1]==0
MSG("THE PROBE DID NOT TOUCH")
SETAL(61991)
M0
ENDIF
R101=$AA_MW[Z]
MEAS=1 G1 X300.000 Y-50.000 Z150.000 F2000
STOPRE
IF $AC_MEA[1]==1
MSG("THE PROBE TOUCHED DURING A PROTECTED MOVE")
SETAL(61992)
M0
ENDIF
;VARIABLE prlength = R102
R102=80+(R101-10)
MEAS=1 G1 X300.000 Y-50.000 Z200.000 F2000
STOPRE
IF $AC_MEA[1]==1
MSG("THE PROBE TOUCHED DURING A PROTECTED MOVE")
SETAL(61992)
M0
ENDIF
$TC_DP3[5,1]=R102
M5
M30
