{
  "$schema": "https://turbo.build/schema.json",
  "ui": "stream",
  "tasks": {
    "typecheck": {
      "dependsOn": ["^typecheck"],
      "inputs": [
        "tsconfig.json",
        "tsconfig.*.json",
        "src/**/*.ts",
        "src/**/*.tsx",
        "app/**/*.ts",
        "app/**/*.tsx",
        "components/**/*.ts",
        "components/**/*.tsx",
        "lib/**/*.ts",
        "lib/**/*.tsx",
        "modules/**/*.ts",
        "package.json"
      ],
      "outputs": []
    },
    "build": {
      "dependsOn": ["^build"],
      "inputs": [
        "tsconfig.json",
        "tsconfig.*.json",
        "src/**/*.ts",
        "src/**/*.tsx",
        "app/**/*.ts",
        "app/**/*.tsx",
        "components/**/*.ts",
        "components/**/*.tsx",
        "lib/**/*.ts",
        "lib/**/*.tsx",
        "modules/**/*.ts",
        "global.css",
        "tailwind.config.js",
        "babel.config.js",
        "metro.config.js",
        "app.json",
        "assets/**",
        "vite.config.*",
        "index.html",
        "package.json"
      ],
      "outputs": ["dist/**", "build/**"]
    },
    "test": {
      "dependsOn": ["^typecheck"],
      "inputs": [
        "tsconfig.json",
        "tsconfig.*.json",
        "src/**/*.ts",
        "test/**/*.ts",
        "lib/**/*.ts",
        "package.json"
      ],
      "outputs": ["coverage/**"]
    },
    "lint": {
      "dependsOn": [],
      "outputs": []
    }
  }
}