{
  "name": "cadcamfun",
  "private": true,
  "license": "SEE LICENSE IN LICENSE",
  "version": "0.1.28",
  "type": "module",
  "packageManager": "bun@1.4.4",
  "engines": {
    "bun": ">=1.4.4"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "typecheck": "turbo run typecheck && bun check -p tsconfig.json",
    "test": "bun test packages apps scripts",
    "bench:cam": "bun --no-env-file scripts/cam-performance.ts",
    "build": "bun scripts/build.ts",
    "build:sidecar": "bun scripts/build.ts --only=compile,resources",
    "build:desktop": "bun run --filter @cadcamfun/desktop build",
    "desktop:dev": "bun run build:sidecar && bun run --filter @cadcamfun/desktop tauri dev",
    "generate": "bun run --filter @cadcamfun/api generate",
    "generate:check": "bun run --filter @cadcamfun/api generate:check",
    "db:generate": "bun run --filter @cadcamfun/db generate",
    "db:migrate": "bun run --filter @cadcamfun/db migrate",
    "release": "./scripts/release",
    "release:version": "bun --no-env-file scripts/release-version.ts",
    "changelog": "bun --no-env-file scripts/changelog.ts",
    "lint:workflows": "bun --no-env-file scripts/lint-workflows.ts",
    "turbo": "turbo"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "babel-plugin-module-resolver": "^5.0.2",
    "babel-preset-expo": "~57.0.14",
    "nativewind": "^4.1.23",
    "react-native-worklets": "0.10.1",
    "turbo": "^2.11.7",
    "typescript": "^5.9.0"
  },
  "overrides": {
    "@effect/platform-node-shared": "4.0.0-rc.112",
    "@effect/platform-node": "4.0.0-rc.112"
  }
}
