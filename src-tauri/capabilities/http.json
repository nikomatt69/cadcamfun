{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "http",
  "description": "HTTP client capabilities with specific scopes",
  "windows": [
    "main"
  ],
  "permissions": [
    {
      "identifier": "http:default",
      "allow": [
        {
          "url": "http://localhost:*"
        },
        {
          "url": "https://localhost:*"
        },
        {
          "url": "http://127.0.0.1:*"
        },
        {
          "url": "https://127.0.0.1:*"
        },
        {
          "url": "https://cadcamfun.xyz/**"
        },
        {
          "url": "https://*.cadcamfun.xyz/**"
        },
        {
          "url": "https://api.openai.com/**"
        },
        {
          "url": "https://api.anthropic.com/**"
        },
        {
          "url": "https://api.github.com/**"
        },
        {
          "url": "https://api.resend.com/**"
        },
        {
          "url": "https://api.lemonsqueezy.com/**"
        },
        {
          "url": "https://api.polar.sh/**"
        },
        {
          "url": "https://*.s3.*.amazonaws.com/**"
        },
        {
          "url": "https://*.auth0.com/**"
        },
        {
          "url": "https://endpoint.4everland.co/**"
        },
        {
          "url": "https://*.neon.tech/**"
        },
        {
          "url": "https://*.auth0.com/**"
        },
        {
          "url": "https://*.auth0.com/**"
        },
        {
          "url": "https://*.auth0.com/**"
        },
        {
          "url": "https://*.auth0.com/**"
        },
        {
          "url": "https://better-auth.com/**"
        },
        {
          "url": "https://*.better-auth.com/**"
        }
      ]
    }
  ]
}