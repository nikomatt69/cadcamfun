{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "http",
  "description": "HTTP client capabilities with specific scopes",
  "windows": ["main"],
  "permissions": [
    {
      "identifier": "http:default",
      "allow": [
        {
          "url": "http://localhost:*"
        },
        {
          "url": "https://localhost:*"
        },
        {
          "url": "http://127.0.0.1:*"
        },
        {
          "url": "https://127.0.0.1:*"
        },
        {
          "url": "https://cadcamfun.xyz/**"
        },
        {
          "url": "https://*.cadcamfun.xyz/**"
        },
        {
          "url": "https://api.openai.com/**"
        },
        {
          "url": "https://api.anthropic.com/**"
        }
      ]
    }
  ]
}