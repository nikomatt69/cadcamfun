{
  "$schema": "../node_modules/@tauri-apps/cli/schema.json",
  "productName": "CADCAM FUN",
  "version": "1.1.0",
  "identifier": "com.cadcamfun.desktop",
  "build": {
    "beforeDevCommand": "yarn dev",
    "beforeBuildCommand": "yarn build:export",
    "devUrl": "http://localhost:3000",
    "frontendDist": "../out"
  },
  "plugins": {
    "updater": {
      "active": true,
      "endpoints": [
        "https://cadcamfun.xyz/api/updates"
      ],
      "dialog": true,
      "pubkey": ""
    },
    "deep-link": {
      "desktop": {
        "schemes": [
          "cadcamfun",
          "cadcamfun-desktop",
          "tauri"
        ]
      }
    },
    "sql": {
      "postgres": {
        "enabled": true,
        "maxConnections": 20,
        "connectionTimeout": 30000,
        "idleTimeout": 600000
      }
    }
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "fullscreen": false,
        "resizable": true,
        "title": "CAD/CAM FUN - Professional CAD/CAM Software",
        "width": 1400,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 768,
        "center": true,
        "decorations": true,
        "alwaysOnTop": false,
        "skipTaskbar": false,
        "theme": null,
        "titleBarStyle": "Visible",
        "hiddenTitle": false,
        "acceptFirstMouse": false,
        "tabbingIdentifier": "cadcamfun"
      }
    ],
    "security": {
      "csp": {
        "default-src": [
          "'self'",
          "localhost:*",
          "127.0.0.1:*",
          "tauri:",
          "cadcamfun.xyz",
          "*.cadcamfun.xyz",
          "http://localhost:3001",
          "https://localhost:3001"
        ],
        "script-src": [
          "'self'",
          "'unsafe-eval'",
          "'unsafe-inline'",
          "localhost:*",
          "127.0.0.1:*",
          "http://localhost:3000",
          "https://localhost:3000",
          "http://localhost:3001",
          "https://localhost:3001",
          "tauri:",
          "cadcamfun.xyz",
          "*.cadcamfun.xyz"
        ],
        "connect-src": [
          "'self'",
          "localhost:*",
          "127.0.0.1:*",
          "http://localhost:3001",
          "https://localhost:3001",
          "ws://localhost:*",
          "wss://localhost:*",
          "https://cadcamfun.xyz",
          "wss://cadcamfun.xyz",
          "https://api.openai.com",
          "https://api.anthropic.com",
          "https://github.com",
          "https://api.github.com",
          "cadcamfun:",
          "ipc:",
          "tauri:",
          "*.neon.tech",
          "*.auth0.com",
          "*.s3.*.amazonaws.com",
          "https://api.resend.com",
          "https://endpoint.4everland.co",
          "https://api.lemonsqueezy.com",
          "https://*.lemonsqueezy.com",
          "https://api.polar.sh"
        ],
        "img-src": [
          "'self'",
          "data:",
          "blob:",
          "https:",
          "tauri:",
          "localhost:*",
          "127.0.0.1:*",
          "*.s3.*.amazonaws.com"
        ],
        "style-src": [
          "'self'",
          "'unsafe-inline'",
          "https:",
          "localhost:*",
          "tauri:",
          "127.0.0.1:*",
          "*.auth0.com"
        ],
        "font-src": [
          "'self'",
          "data:",
          "https:",
          "localhost:*",
          "127.0.0.1:*",
          "*.auth0.com"
        ]
      }
    },
    "trayIcon": {
      "iconPath": "icons/icon.png",
      "iconAsTemplate": true,
      "menuOnLeftClick": false,
      "tooltip": "CAD/CAM FUN"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [],
    "externalBin": [],
    "copyright": "",
    "category": "DeveloperTool",
    "shortDescription": "Professional CAD/CAM Software",
    "longDescription": "Advanced Computer-Aided Design and Manufacturing software with integrated toolpath generation, 3D modeling, and CNC machining capabilities.",
    "macOS": {
      "frameworks": [],
      "minimumSystemVersion": "10.13",
      "exceptionDomain": "",
      "signingIdentity": null,
      "providerShortName": null,
      "entitlements": null
    },
    "windows": {
      "certificateThumbprint": null,
      "digestAlgorithm": "sha256",
      "timestampUrl": ""
    }
  }
}